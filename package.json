{
  "name": "ledgerly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ledgerly — accounts payable, accounts receivable and reporting for web and mobile",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "start": "node server/src/index.js",
    "dev": "node scripts/dev.mjs",
    "seed": "node server/src/seed.js",
    "reset": "node scripts/reset.mjs",
    "test": "node --test --test-isolation=none \"server/test/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.52.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
